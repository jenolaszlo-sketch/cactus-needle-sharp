<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CactusNeedleSharp.Baize</PackageId>
    <Title>CactusNeedleSharp.Baize</Title>
    <Description>Conversation-isolated CactusNeedleSharp adapter contracts for Baize tool planning.</Description>
    <PackageTags>baize;needle;llm;ai;tool-calling;function-calling</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CactusNeedleSharp/CactusNeedleSharp.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
