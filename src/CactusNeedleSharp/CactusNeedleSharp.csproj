<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CactusNeedleSharp</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Title>CactusNeedleSharp</Title>
    <Description>Unofficial .NET wrapper for Needle 2 by Cactus Compute, providing local schema-constrained tool calling and structured extraction.</Description>
    <Authors>CactusNeedleSharp contributors</Authors>
    <PackageTags>needle;cactus;cactus-compute;llm;ai;tool-calling;function-calling;structured-output;json-schema;on-device;local-ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
