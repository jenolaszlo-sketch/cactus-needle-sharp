<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CactusNeedleSharp.Worker</AssemblyName>
    <RootNamespace>CactusNeedleSharp.Worker</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cactusneedlesharp-worker</ToolCommandName>
    <PackageId>CactusNeedleSharp.Worker</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Title>CactusNeedleSharp.Worker</Title>
    <Description>Isolated worker process for the unofficial CactusNeedleSharp .NET wrapper.</Description>
    <Authors>CactusNeedleSharp contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CactusNeedleSharp/CactusNeedleSharp.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
